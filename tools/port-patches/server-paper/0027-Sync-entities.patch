+    @Nullable
+    public Entity getEntityIgnoringAccessible(UUID uuid) {
+        final long attempt = this.entityByLock.tryOptimisticRead();
+        if (attempt != 0L) {
+            try {
+                final Entity ret = this.entityByUUID.get(uuid);
+
+                if (this.entityByLock.validate(attempt)) {
+                    return ret;
+                }
+            } catch (final Error error) {
+                throw error;
+            } catch (final Throwable thr) {
+                // ignore
+            }
+        }
+
+        this.entityByLock.readLock();
+        try {
+            return this.entityByUUID.get(uuid);
+        } finally {
+            this.entityByLock.tryUnlockRead();
+        }
+    }
+
+    public boolean isChunkLoaded(ChunkPos chunkPos) {
+        return getChunk(chunkPos.x, chunkPos.z) != null;
+    }
+    // MultiPaper end
+
