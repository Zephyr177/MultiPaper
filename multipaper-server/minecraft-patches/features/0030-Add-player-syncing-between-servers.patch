 public class Connection extends SimpleChannelInboundHandler<Packet<?>> {
@@ -652,6 +654,9 @@ public class Connection extends SimpleChannelInboundHandler<Packet<?>> {
     public void disconnect(final DisconnectionDetails details) {
         this.preparing = false; // Spigot
         this.clearPacketQueue(); // Paper - Optimize network
+        if (getPlayer() != null && getPlayer().hasRegisteredOnMaster) {
+            MultiPaper.sendPlayerDisconnect(getPlayer()); // MultiPaper
+        }
         if (this.channel == null) {
             this.delayedDisconnect = details;
         }
