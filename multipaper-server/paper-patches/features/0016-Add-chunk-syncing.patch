+    }
+
+    public static NewChunkHolder getChunkHolder(String world, int x, int z) {
+        CraftWorld craftWorld = ((CraftWorld) Bukkit.getWorld(world));
+        return craftWorld != null ? getChunkHolder(craftWorld.getHandle(), x, z) : null;
+    }
